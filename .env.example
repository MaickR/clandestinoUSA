# URL base para sitemap y entorno local
SITE_URL=http://localhost:3000

# Contacto de notificaciones operativas
CONTACT_MAIL_TO=info@theclandestinousa.com
CONTACT_MAIL_FROM=noreply@theclandestinousa.com
CONTACT_MAIL_FROM_NAME=The Clandestino USA

# Stripe (usar claves restringidas en desarrollo y producción)
STRIPE_PUBLISHABLE_KEY=pk_test_reemplazar
STRIPE_SECRET_KEY=sk_test_reemplazar
STRIPE_WEBHOOK_SECRET=whsec_reemplazar

# PayPal (sandbox primero)
PAYPAL_CLIENT_ID=reemplazar
PAYPAL_CLIENT_SECRET=reemplazar
PAYPAL_ENV=sandbox

# Base de datos futura (cuando se active capa PHP en capas)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clandestino
DB_USERNAME=usuario
DB_PASSWORD=password

# Sesiones y seguridad
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles
SESSION_SECURE_COOKIE=false
SESSION_SAMESITE=Strict
