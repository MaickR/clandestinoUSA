# El marcador solo se crea tras aprobar el release y sus requisitos audiovisuales.
# Sin él se conserva la denegación de C6; PHP built-in ignora .htaccess.
<IfModule mod_authz_core.c>
  Require expr "-f '%{DOCUMENT_ROOT}/.home-public-enabled'"
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
